# ============================================================
#  Claw Pet 环境变量模板
# ============================================================
#  用法：
#    1. 复制成 .env     →   copy .env.example .env    (macOS/Linux: cp)
#    2. 按下面的说明填
#    3. 本地开发跑 start.bat / ./scripts/start.sh
#       容器部署跑 deploy.bat / ./scripts/deploy.sh
#
#  也可以什么都不做 —— 两个脚本都会在发现 .env 不存在时
#  自动生成一份（含随机密码）。
#
#  .env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================


# ============================================================
#  一、本地开发（start 脚本用）
#      这一组对「容器部署」无效 —— 容器里的连接串由 docker-compose
#      自己拼（数据库主机名是 mysql 这个服务名，不是 localhost）
# ============================================================

# 完整连接串。改端口 / 库名 / 时区都在这条里改
DB_URL=jdbc:mysql://localhost:3306/claw_pet?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# 数据库账号密码（本机 root 没设密码就留空）
DB_USERNAME=root
DB_PASSWORD=

# Redis 地址。默认本机 6379
REDIS_HOST=localhost
REDIS_PORT=6379


# ============================================================
#  二、容器部署（deploy 脚本 / docker compose 用）
#      ⚠️ 下面三个是必填，留空的话 compose 会直接报错并提示你回来填
# ============================================================

# 数据库名
DB_NAME=claw_pet

# 数据库 root 密码（容器部署必填；本机开发可以留空）
# 生成随机密码：见文件末尾
DB_PASSWORD=

# Redis 密码（容器部署必填）
REDIS_PASSWORD=

# JWT 签名密钥（≥32 字节）—— 部署到公网前建议必填！
# 留空 = 启动时随机生成一个临时密钥：项目照常跑，代码里也没有任何「写死的默认密钥」
# 可供别人伪造登录态；代价是重启后所有在线用户需要重新登录。
# 所以本地开发可以留空，生产环境请显式填一个固定值。
JWT_SECRET=

# 对外端口。前端是唯一入口，改 WEB_PORT 就能换端口
WEB_PORT=3000
# 后端端口（只是方便调接口，不需要可以注释掉 docker-compose 里那两行）
BACKEND_PORT=8081

# 后端 JVM 参数
JAVA_OPTS=-Xms256m -Xmx512m


# ============================================================
#  生成随机密码 / 密钥
# ============================================================
#   macOS / Linux:
#       openssl rand -base64 24          # 密码
#       openssl rand -base64 48          # JWT_SECRET（要 ≥32 字节）
#
#   Windows PowerShell:
#       -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 24 | % {[char]$_})   # 密码
#       [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))          # JWT_SECRET
#
#   Docker 自带的办法（不用装 openssl）：
#       docker run --rm alpine/openssl rand -base64 24
